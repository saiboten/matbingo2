generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  image          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  familyId       String?
  accounts       Account[]
  mealPlans      MealPlan[]
  shoppingLists  ShoppingList[]
  createdRecipes Recipe[]       @relation("CreatedBy")
  sessions       Session[]
  family         Family?        @relation(fields: [familyId], references: [id])
  emailVerified  Boolean        @default(false)

  @@map("user")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Family {
  id            String         @id @default(uuid())
  name          String
  inviteCode    String         @unique
  // The user who created the family. Older families have none; see effectiveAdminId in lib/family.ts
  adminId       String?
  // Set once the family has been given the default everyday items (see lib/common-items.ts)
  commonItemsSeeded Boolean    @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  eatenLogs     EatenLog[]
  mealPlans     MealPlan[]
  shoppingLists ShoppingList[]
  ingredients   Ingredient[]
  recipes       Recipe[]
  members       User[]
}

model Recipe {
  id           String       @id @default(uuid())
  name         String
  ingredients  String
  description  String?
  externalUrl  String?
  score        Int
  type         DishType
  suitableDays Day[]
  hibernating  Boolean      @default(false)
  familyId     String
  createdById  String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  eatenLogs    EatenLog[]
  mealPlans    MealPlan[]
  createdBy    User         @relation("CreatedBy", fields: [createdById], references: [id])
  family       Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  image        RecipeImage?
  steps        RecipeStep[]

  @@index([familyId])
  @@index([type])
  @@index([score])
}

model RecipeStep {
  id       String  @id @default(uuid())
  recipeId String
  position Int
  title    String?
  text     String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, position])
}

// Ready-made recipes every family can copy into its own collection (managed by the super admin).
// A family's copy is an ordinary Recipe, so editing it never changes the blueprint.
model Blueprint {
  id           String          @id
  name         String
  description  String?
  ingredients  String
  type         DishType
  score        Int             @default(5)
  suitableDays Day[]
  position     Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  steps        BlueprintStep[]
  image        BlueprintImage?
}

model BlueprintStep {
  id          String    @id @default(uuid())
  blueprintId String
  position    Int
  title       String?
  text        String
  blueprint   Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)

  @@unique([blueprintId, position])
}

model BlueprintImage {
  id          String    @id @default(uuid())
  blueprintId String    @unique
  base64      String
  mimeType    String
  blueprint   Blueprint @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
}

model RecipeImage {
  id        String   @id @default(uuid())
  base64    String
  mimeType  String
  recipeId  String   @unique
  createdAt DateTime @default(now())
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model MealPlan {
  id          String     @id @default(uuid())
  date        DateTime   @db.Date
  option      PlanOption
  recipeId    String?
  otherText   String?
  familyId    String
  plannedById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  plannedBy   User       @relation(fields: [plannedById], references: [id])
  recipe      Recipe?    @relation(fields: [recipeId], references: [id])

  @@unique([familyId, date])
  @@index([familyId, date])
}

model ShoppingList {
  id          String             @id @default(uuid())
  familyId    String
  createdById String
  createdAt   DateTime           @default(now())
  dates       DateTime[]         @db.Date
  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy   User               @relation(fields: [createdById], references: [id])
  items       ShoppingListItem[]

  @@index([familyId, createdAt])
}

model Ingredient {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  nameKey   String
  aisle     Aisle    @default(OTHER)
  // Offered as a one-tap extra when making a shopping list
  common    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, nameKey])
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  shoppingListId String
  name           String
  sources        String[]
  aisle          Aisle        @default(OTHER)
  checked        Boolean      @default(false)
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

model EatenLog {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  recipeId  String
  familyId  String
  createdAt DateTime @default(now())
  family    Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([familyId, recipeId, date])
  @@index([familyId, date])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum Aisle {
  PRODUCE
  MEAT
  FISH
  FROZEN
  CHILLED
  BAKERY
  DRY
  OTHER
}

enum DishType {
  MEAT
  FISH
  VEGAN
  OTHER
}

enum Day {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PlanOption {
  MANUAL
  ALGORITHM
  OTHER
}
